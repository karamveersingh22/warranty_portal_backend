# MongoDB Connection
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/warranty_portal
DATABASE_NAME=warranty_portal

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Email OTP (Brevo API)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@yourbrand.com
BREVO_SENDER_NAME="Warranty Portal"

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_RESEND=3

# Admin
ADMIN_EMAIL=admin@yourbrand.com

# Frontend
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
DEBUG=true
