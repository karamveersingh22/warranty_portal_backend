# MongoDB Connection
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/warranty_portal
DATABASE_NAME=warranty_portal

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Gmail SMTP for OTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_RESEND=3

# Admin
ADMIN_EMAIL=admin@yourbrand.com

# Frontend
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
DEBUG=true
